{
  "name": "cb-dsh",
  "displayName": "CreditBridge",
  "description": "CreditBridge: configures the gateway address and API key in DeepSeek Harness, shows per-account credits, and forwards login callbacks over a local loopback tunnel.",
  "version": "0.10.3",
  "author": "local",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "credits",
    "workbuddy",
    "trae"
  ],
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/profile-models.mjs && node test/write-provider.mjs && node test/setup.mjs && node test/context-picker.mjs && node test/badge-strip.mjs && node test/tunnel.mjs && node test/events-client.mjs && node test/not-configured.mjs",
    "test:profile": "node test/profile-models.mjs",
    "test:provider": "node test/write-provider.mjs",
    "test:setup": "node test/setup.mjs",
    "test:picker": "node test/context-picker.mjs",
    "test:tunnel": "node test/tunnel.mjs && node test/events-client.mjs",
    "test:not-configured": "node test/not-configured.mjs",
    "test:badge": "node test/badge-strip.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1 <0.3.0",
    "react": "^18.2.0"
  }
}
